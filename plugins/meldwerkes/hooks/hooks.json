{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$HOME/.small-brain/session-context.json\" 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Loading Meldwerkes principles"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/capture_prompt.py\" 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Recording signal"
          }
        ]
      }
    ]
  }
}
